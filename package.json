{
  "name": "github-community-wall",
  "version": "1.0.0",
  "description": "Generate dynamic GitHub community walls for followers, contributors, and sponsors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "github-community-wall": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "check": "pnpm check:biome && pnpm check:typescript",
    "check:biome": "biome ci .",
    "check:typescript": "tsc --noEmit",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "prepack": "pnpm check && pnpm test && pnpm build"
  },
  "keywords": [
    "github",
    "community",
    "followers",
    "contributors",
    "sponsors",
    "avatars",
    "readme"
  ],
  "author": {
    "name": "Alejandro Arancibia",
    "email": "alejandro.arancibia.aranda@gmail.com",
    "url": "https://github.com/ale0aranda"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ale0aranda/github-community-wall.git"
  },
  "bugs": {
    "url": "https://github.com/ale0aranda/github-community-wall/issues"
  },
  "homepage": "https://github.com/ale0aranda/github-community-wall#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@ale0aranda/rules": "^0.3.2",
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "tsup": "8.2.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.53",
    "commander": "12.1.0"
  },
  "packageManager": "pnpm@11.5.1"
}
