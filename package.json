{
  "name": "github-community-wall-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @community-wall/docs dev",
    "build": "pnpm build:cli && pnpm build:docs",
    "build:cli": "pnpm --filter github-community-wall build",
    "build:docs": "pnpm --filter @community-wall/docs build",
    "check": "pnpm check:biome && pnpm check:typescript && pnpm check:docs",
    "check:biome": "biome ci .",
    "check:typescript": "pnpm --filter github-community-wall check:typescript",
    "check:docs": "pnpm --filter @community-wall/docs check",
    "format": "biome check --write .",
    "test": "pnpm --filter github-community-wall test",
    "test:watch": "pnpm --filter github-community-wall test:watch",
    "test:coverage": "pnpm --filter github-community-wall test:coverage",
    "test:package": "pnpm --filter github-community-wall test:package",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "pnpm check && pnpm test && pnpm build:cli && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@ale0aranda/rules": "^0.7.0",
    "@biomejs/biome": "^2.5.11",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1"
  }
}
