{
  "name": "github-followers-graph",
  "version": "1.0.0",
  "description": "Generate an image graph containing GitHub follower avatars",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "check": "pnpm check:biome && pnpm check:typescript",
    "check:biome": "biome ci .",
    "check:typescript": "tsc --noEmit",
    "format": "biome check --write .",
    "prepare": "husky"
  },
  "keywords": ["github", "followers", "graph"],
  "author": "alejandro.arancibia.aranda@gmail.com",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@ale0aranda/rules": "^0.3.2",
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "tsup": "8.2.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.53",
    "commander": "12.1.0"
  },
  "packageManager": "pnpm@11.5.1"
}
