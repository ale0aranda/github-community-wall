---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "GitHub Community Wall — Documentation",
  description = "Generate avatar walls for your GitHub community. Learn how to install, configure, and use GitHub Community Wall.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f8f9fb" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <title>{title}</title>

    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("community-wall-theme");
        document.documentElement.dataset.theme =
          savedTheme === "dark" ? "dark" : "light";
      } catch {
        document.documentElement.dataset.theme = "light";
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    <main id="content" class="document">
      <slot />
    </main>

    <p id="copy-status" class="sr-only" role="status" aria-live="polite"></p>
  </body>
</html>
