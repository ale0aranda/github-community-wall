---
import CodeBlock from "../components/CodeBlock.astro";
import Icon from "../components/Icon.astro";
import DocsLayout from "../layouts/DocsLayout.astro";

const repository = "https://github.com/ale0aranda/github-community-wall";
const baseUrl = import.meta.env.BASE_URL;

const firstWall = [
  "npx github-community-wall contributors owner/repository \\",
  "  --output community-wall.png \\",
  "  --limit 100",
].join("\n");

const sources = [
  "npx github-community-wall followers octocat",
  "npx github-community-wall members organization",
].join("\n");

const customWall = [
  "npx github-community-wall contributors owner/repository \\",
  "  --theme github-light \\",
  "  --shape circle \\",
  "  --format svg \\",
  "  --output community-wall.svg",
].join("\n");

const banner = [
  "npx github-community-wall followers octocat \\",
  "  --twitter-banner \\",
  "  --output followers-banner.png",
].join("\n");

const readme = [
  "npx github-community-wall readme contributors owner/repository \\",
  "  --output assets/contributors.png \\",
  "  --theme github-light",
].join("\n");
---

<DocsLayout>
  <header class="intro">
    <h1>GitHub Community Wall</h1>

    <p class="lead">
      Generate a visual wall featuring the people who are part of your GitHub
      community.
    </p>

    <p>
      A command-line tool for creating images of followers, contributors,
      sponsors, and organizations. Simple, configurable, and ready to share in
      your README, website, or a banner.
    </p>

    <CodeBlock code="npx github-community-wall --help" />

    <p class="repository-caption">
      Open source, built to celebrate your community.
    </p>

    <a class="repository-link" href={repository}>
      <span class="repository-name">
        <Icon name="github" size={23} />
        <span>ale0aranda/github-community-wall</span>
      </span>

      <Icon name="arrow" size={19} />
    </a>
  </header>

  <section class="guide" aria-labelledby="getting-started">
    <h2 id="getting-started" class="section-title">
      <Icon name="book" size={23} />
      Getting started
    </h2>

    <p>
      You need <strong>Node.js 22.13 or later</strong>. You can run the tool with
      <code>npx</code> without installing it globally, or install it if you will
      use it frequently.
    </p>

    <p>
      The tool queries GitHub, downloads avatars, and arranges people in an
      image. Choose the community, adjust the design, and decide where to save
      the result.
    </p>

    <CodeBlock code="npm install -g github-community-wall" />

    <section class="topic" aria-labelledby="authentication">
      <h3 id="authentication">Connect to GitHub</h3>

      <p>
        Configure a GitHub token in your environment. The
        <code>GITHUB_TOKEN</code> variable lets you query the API without
        including credentials directly in commands.
      </p>

      <CodeBlock code="export GITHUB_TOKEN=github_pat_..." />

      <p class="note">
        Replace the example value with your token. The required permissions
        depend on the source; sponsors require access to the authenticated
        maintainer's sponsorship data.
      </p>
    </section>

    <section class="topic" aria-labelledby="first-wall">
      <h3 id="first-wall">Your first wall</h3>

      <p>
        To show the people who contribute to a repository, use
        <code>contributors</code> followed by <code>owner/repository</code>.
        Choose an output file and limit the number of avatars.
      </p>

      <CodeBlock code={firstWall} />

      <p>
        Replace <code>owner/repository</code> with your repository. You will get
        <code>community-wall.png</code> in the directory where you ran the
        command: an image ready to publish.
      </p>

      <p class="note">
        Contributor walls exclude bots by default. You can adjust the filters
        to decide who appears.
      </p>
    </section>

    <section class="topic" aria-labelledby="community">
      <h3 id="community">Choose your community</h3>

      <p>
        Every community has different ways to participate. In addition to
        contributors, you can generate walls for followers, sponsors,
        stargazers, watchers, and organization members.
      </p>

      <p>
        Use a user for <code>followers</code> and <code>sponsors</code>, a
        repository for <code>contributors</code>, <code>stargazers</code>, and
        <code>watchers</code>, or an organization for <code>members</code>.
      </p>

      <CodeBlock code={sources} />
    </section>

    <section class="topic" aria-labelledby="customization">
      <h3 id="customization">Make it yours</h3>

      <p>
        Customize the theme, background, avatar shape, and spacing. Add titles,
        subtitles, or a watermark to tailor the result to your project.
      </p>

      <p>
        PNG is the default format. You can also export to JPEG, WebP, SVG, HTML,
        or JSON. HTML generates a standalone file; JSON includes avatar and
        design metadata.
      </p>

      <CodeBlock code={customWall} />

      <p>
        If you use the same options repeatedly, save them in
        <code>.community-wall.json</code>. Commands read this file from the
        current directory, and terminal options take precedence.
      </p>

      <CodeBlock code="npx github-community-wall config init" />
    </section>

    <section class="topic" aria-labelledby="publishing">
      <h3 id="publishing">Share and automate</h3>

      <p>
        Include the wall in your README, share it on your website, or use it in
        a post. The <code>--twitter-banner</code> option generates a
        <strong>1500 × 500</strong> follower banner for X.
      </p>

      <CodeBlock code={banner} />

      <p>
        The <code>readme</code> command updates the wall block between its
        markers. If they do not exist, it adds the block to the document.
      </p>

      <CodeBlock code={readme} />

      <p>
        To keep the image up to date, you can run the tool on a schedule with
        GitHub Actions. The repository includes an example workflow that
        generates and saves the walls.
      </p>

      <a
        class="text-link"
        href={`${repository}/blob/main/.github/workflows/update-community-wall.yml`}
      >
        View automation example
        <Icon name="arrow" size={15} />
      </a>
    </section>
  </section>

  <section class="examples" aria-labelledby="examples">
    <h2 id="examples" class="section-title">
      <Icon name="users" size={23} />
      Your community
    </h2>

    <p>
      Two ways to showcase the people who follow your work and help build it.
    </p>

    <div class="example-grid">
      <figure class="example">
        <a
          href={`${baseUrl}/images/followers.png`}
          aria-label="View full follower wall"
        >
          <img
            src={`${baseUrl}/images/followers.png`}
            alt="Avatar wall generated from GitHub followers"
            loading="lazy"
            decoding="async"
            width="640"
            height="640"
          />
        </a>

        <figcaption>
          <h3>Followers</h3>
          <p>People who follow your work.</p>
        </figcaption>
      </figure>

      <figure class="example">
        <a
          href={`${baseUrl}/images/contributors.png`}
          aria-label="View full contributor wall"
        >
          <img
            src={`${baseUrl}/images/contributors.png`}
            alt="Avatar wall generated from repository contributors"
            loading="lazy"
            decoding="async"
            width="640"
            height="640"
          />
        </a>

        <figcaption>
          <h3>Contributors</h3>
          <p>People who build with you.</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="help" aria-labelledby="help">
    <h2 id="help">Need help?</h2>

    <p>
      Run <code>--help</code> to explore the options. Use
      <code>doctor</code> to check your configuration and token without
      displaying it.
    </p>

    <CodeBlock code="npx github-community-wall doctor" />

    <div class="help-links">
      <a class="text-link" href={`${repository}#cli-reference`}>
        Command reference
        <Icon name="arrow" size={15} />
      </a>

      <a class="text-link" href={`${repository}/issues`}>
        Report an issue
        <Icon name="arrow" size={15} />
      </a>
    </div>
  </section>

  <footer class="footer">
    <p>Open source · MIT</p>

    <div class="theme-switch" role="group" aria-label="Page theme">
      <button
        type="button"
        data-set-theme="light"
        aria-label="Use light theme"
        aria-pressed="true"
      >
        <Icon name="sun" size={17} />
      </button>

      <button
        type="button"
        data-set-theme="dark"
        aria-label="Use dark theme"
        aria-pressed="false"
      >
        <Icon name="moon" size={17} />
      </button>
    </div>
  </footer>
</DocsLayout>

<script>
  const themeButtons =
    document.querySelectorAll<HTMLButtonElement>("[data-set-theme]");

  function updateButtons(theme: string) {
    themeButtons.forEach((button) => {
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.setTheme === theme),
      );
    });
  }

  updateButtons(document.documentElement.dataset.theme ?? "light");

  themeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const theme = button.dataset.setTheme;

      if (theme !== "light" && theme !== "dark") return;

      document.documentElement.dataset.theme = theme;
      updateButtons(theme);

      try {
        localStorage.setItem("community-wall-theme", theme);
      } catch {
        // The theme still works when storage is unavailable.
      }
    });
  });
</script>
